<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal7Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Report Station Problems &amp; Equipment Failures">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Select Equipment:" />
        <ComboBox fx:id="equipmentCombo" layoutX="170.0" layoutY="76.0" prefWidth="230.0" promptText="Choose Equipment" />

        <Label layoutX="30.0" layoutY="130.0" text="Problem Level:" />
        <ComboBox fx:id="priorityCombo" layoutX="170.0" layoutY="126.0" prefWidth="230.0" promptText="Choose Priority" />

        <Label layoutX="30.0" layoutY="180.0" text="Problem Details:" />
        <TextField fx:id="detailsField" layoutX="170.0" layoutY="176.0" prefWidth="230.0" promptText="Write short note" />

        <Button fx:id="checkBtn" layoutX="30.0" layoutY="240.0" onAction="#handleCheckStatus" text="Check Equipment" />
        <Button fx:id="submitBtn" layoutX="160.0" layoutY="240.0" onAction="#handleSubmitReport" text="Send Report" />
        <Button fx:id="Backbutton" layoutX="265.0" layoutY="240.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="300.0" text="Select equipment and problem level." />
    </children>
</AnchorPane>
