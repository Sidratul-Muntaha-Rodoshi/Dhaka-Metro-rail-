<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal2Controller">
    <children>
        <Label layoutX="25.0" layoutY="20.0" text="Record Revenue Collected from Penalties">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="penaltyTable" layoutX="25.0" layoutY="60.0" onMouseClicked="#handleRowSelect" prefHeight="200.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="penaltyIdCol" prefWidth="100.0" text="Penalty ID" />
                <TableColumn fx:id="passengerIdCol" prefWidth="120.0" text="Passenger ID" />
                <TableColumn fx:id="reasonCol" prefWidth="170.0" text="Fine Reason" />
                <TableColumn fx:id="amountCol" prefWidth="130.0" text="Amount (BDT)" />
                <TableColumn fx:id="statusCol" prefWidth="125.0" text="Status" />
            </columns>
        </TableView>

        <Label layoutX="25.0" layoutY="280.0" text="Passenger ID:" />
        <Label fx:id="passengerIdLabel" layoutX="115.0" layoutY="280.0" text="None" />

        <Label layoutX="240.0" layoutY="280.0" text="Reason:" />
        <Label fx:id="reasonLabel" layoutX="295.0" layoutY="280.0" text="None" />

        <Label layoutX="480.0" layoutY="280.0" text="Amount (BDT):" />
        <Label fx:id="amountLabel" layoutX="575.0" layoutY="280.0" text="0.00" />

        <Label layoutX="25.0" layoutY="320.0" text="Penalty Category:" />
        <ComboBox fx:id="categoryCombo" layoutX="135.0" layoutY="316.0" onAction="#handleCategorySelect" prefWidth="160.0" promptText="Select Category" />

        <Label layoutX="330.0" layoutY="320.0" text="Account Code:" />
        <Label fx:id="accountCodeLabel" layoutX="425.0" layoutY="320.0" text="N/A" />

        <Label layoutX="25.0" layoutY="360.0" text="Receipt Number:" />
        <TextField fx:id="receiptField" layoutX="135.0" layoutY="356.0" prefWidth="160.0" promptText="e.g. RCP-105" />
        <Button fx:id="verifyBtn" layoutX="310.0" layoutY="356.0" onAction="#handleVerifyReceipt" text="Verify Receipt" />

        <Button fx:id="saveBtn" layoutX="25.0" layoutY="410.0" onAction="#handleSavePenalty" text="Save Penalty" />
        <Button fx:id="Backbutton" layoutX="130.0" layoutY="410.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="25.0" layoutY="465.0" text="Select a penalty record from the table." />
    </children>
</AnchorPane>
