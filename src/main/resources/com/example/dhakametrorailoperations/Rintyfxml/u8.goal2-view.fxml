<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal2Controller">
    <children>
        <Label layoutX="25.0" layoutY="20.0" text="Record Revenue Collected from Penalties">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="25.0" layoutY="70.0" text="Penalty ID:" />
        <TextField fx:id="penaltyIdField" layoutX="150.0" layoutY="66.0" prefWidth="200.0" promptText="e.g. P-101" />

        <Label layoutX="25.0" layoutY="115.0" text="Passenger ID:" />
        <TextField fx:id="passengerIdField" layoutX="150.0" layoutY="111.0" prefWidth="200.0" promptText="Enter Passenger ID" />

        <Label layoutX="25.0" layoutY="160.0" text="Penalty Category:" />
        <ComboBox fx:id="categoryCombo" layoutX="150.0" layoutY="156.0" onAction="#handleCategorySelect" prefWidth="200.0" promptText="Select Category" />

        <Label layoutX="375.0" layoutY="160.0" text="Account Code:" />
        <Label fx:id="accountCodeLabel" layoutX="465.0" layoutY="160.0" text="N/A" />

        <Label layoutX="25.0" layoutY="205.0" text="Fine Amount (BDT):" />
        <TextField fx:id="amountField" layoutX="150.0" layoutY="201.0" prefWidth="200.0" promptText="Enter Amount" />

        <Label layoutX="25.0" layoutY="250.0" text="Receipt Number:" />
        <TextField fx:id="receiptField" layoutX="150.0" layoutY="246.0" prefWidth="200.0" promptText="e.g. RCP-105" />

        <Button fx:id="saveBtn" layoutX="25.0" layoutY="310.0" onAction="#handleSavePenalty" text="Save Penalty" />
        <Button fx:id="totalBtn" layoutX="130.0" layoutY="310.0" onAction="#handleShowTotal" text="Total Collected" />
        <Button fx:id="Backbutton" layoutX="250.0" layoutY="310.0" onAction="#handleback" text="Back" />
    </children>
</AnchorPane>
