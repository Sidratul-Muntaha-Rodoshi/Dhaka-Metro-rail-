<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal1Controller">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Approve Train Arrival and Departure">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="trainTable" layoutX="30.0" layoutY="60.0" prefHeight="180.0" prefWidth="590.0">
            <columns>
                <TableColumn fx:id="trainIdCol" prefWidth="120.0" text="Train ID" />
                <TableColumn fx:id="routeCol" prefWidth="180.0" text="Route" />
                <TableColumn fx:id="timeCol" prefWidth="130.0" text="Scheduled Time" />
                <TableColumn fx:id="statusCol" prefWidth="158.0" text="Clearance Status" />
            </columns>
        </TableView>

        <Label layoutX="30.0" layoutY="260.0" text="Assign Platform:" />
        <ComboBox fx:id="platformCombo" layoutX="150.0" layoutY="256.0" prefWidth="180.0" promptText="Select Platform" />

        <Label layoutX="355.0" layoutY="260.0" text="Controller PIN:" />
        <PasswordField fx:id="pinField" layoutX="450.0" layoutY="256.0" prefWidth="170.0" promptText="Enter PIN (1234)" />

        <Button fx:id="checkTrackBtn" layoutX="30.0" layoutY="310.0" onAction="#handleCheckTrack" text="Check Track Safety" />
        <Button fx:id="approveBtn" layoutX="170.0" layoutY="310.0" onAction="#handleApproveTrain" text="Approve Clearance" />
        <Button fx:id="Backbutton" layoutX="310.0" layoutY="310.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="365.0" text="Select a train from the table and assign a platform." />
    </children>
</AnchorPane>
