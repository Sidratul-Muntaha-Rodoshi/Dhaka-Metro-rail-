<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal7Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Verify Station Expense Requests">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="75.0" text="Select Request ID:" />
        <ComboBox fx:id="requestIdCombo" layoutX="180.0" layoutY="71.0" prefWidth="220.0" promptText="Choose Request ID" />

        <Label layoutX="30.0" layoutY="120.0" text="Station Name:" />
        <TextField fx:id="stationField" editable="false" layoutX="180.0" layoutY="116.0" prefWidth="220.0" />

        <Label layoutX="30.0" layoutY="165.0" text="Expense Category:" />
        <TextField fx:id="categoryField" editable="false" layoutX="180.0" layoutY="161.0" prefWidth="220.0" />

        <Label layoutX="30.0" layoutY="210.0" text="Requested Amount:" />
        <TextField fx:id="amountField" editable="false" layoutX="180.0" layoutY="206.0" prefWidth="220.0" />

        <Label layoutX="30.0" layoutY="255.0" text="Remarks / Reason:" />
        <TextField fx:id="remarksField" layoutX="180.0" layoutY="251.0" prefWidth="220.0" promptText="Enter approval/rejection note" />

        <Button fx:id="approveBtn" layoutX="30.0" layoutY="310.0" onAction="#handleApproveExpense" text="Approve Expense" />
        <Button fx:id="rejectBtn" layoutX="165.0" layoutY="310.0" onAction="#handleRejectExpense" text="Reject Expense" />
        <Button fx:id="Backbutton" layoutX="285.0" layoutY="310.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="365.0" text="Select a Request ID to review expense details." />
    </children>
</AnchorPane>
