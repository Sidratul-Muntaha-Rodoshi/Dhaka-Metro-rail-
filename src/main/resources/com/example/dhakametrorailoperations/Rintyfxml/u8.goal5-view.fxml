<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal5Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Handle Cash Discrepancies">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="75.0" text="Shift ID:" />
        <TextField fx:id="shiftIdField" layoutX="175.0" layoutY="71.0" prefWidth="210.0" promptText="e.g. SH-102" />

        <Label layoutX="30.0" layoutY="120.0" text="Cashier &amp; Station:" />
        <TextField fx:id="cashierStationField" layoutX="175.0" layoutY="116.0" prefWidth="210.0" promptText="e.g. Rahim - Mirpur 10" />

        <Label layoutX="30.0" layoutY="165.0" text="Expected Cash (BDT):" />
        <TextField fx:id="expectedCashField" layoutX="175.0" layoutY="161.0" prefWidth="210.0" promptText="Enter expected amount" />

        <Label layoutX="30.0" layoutY="210.0" text="Submitted Cash (BDT):" />
        <TextField fx:id="submittedCashField" layoutX="175.0" layoutY="206.0" prefWidth="210.0" promptText="Enter submitted amount" />

        <Label layoutX="30.0" layoutY="255.0" text="Discrepancy Reason:" />
        <ComboBox fx:id="reasonCombo" layoutX="175.0" layoutY="251.0" prefWidth="210.0" promptText="Select Reason" />

        <Label layoutX="30.0" layoutY="300.0" text="Action Note:" />
        <TextField fx:id="noteField" layoutX="175.0" layoutY="296.0" prefWidth="210.0" promptText="Write resolution note" />

        <Button fx:id="reviewBtn" layoutX="30.0" layoutY="360.0" onAction="#handleReviewDetails" text="Check Discrepancy" />
        <Button fx:id="resolveBtn" layoutX="165.0" layoutY="360.0" onAction="#handleResolveDifference" text="Resolve Difference" />
        <Button fx:id="Backbutton" layoutX="305.0" layoutY="360.0" onAction="#handleback" text="Back" />
    </children>
</AnchorPane>
