<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal5Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Announce Train Delays and Important Updates">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Select Train:" />
        <ComboBox fx:id="trainCombo" layoutX="160.0" layoutY="76.0" prefWidth="250.0" promptText="Choose Train" />

        <Label layoutX="30.0" layoutY="130.0" text="Message Type:" />
        <ComboBox fx:id="messageTypeCombo" layoutX="160.0" layoutY="126.0" prefWidth="250.0" promptText="Choose Message Type" />

        <Label layoutX="30.0" layoutY="180.0" text="Message Preview:" />
        <TextField fx:id="messagePreviewField" editable="false" layoutX="160.0" layoutY="176.0" prefWidth="360.0" promptText="Click Create Message to preview" />

        <Button fx:id="previewBtn" layoutX="30.0" layoutY="240.0" onAction="#handlePreviewMessage" text="Create Message" />
        <Button fx:id="sendBtn" layoutX="150.0" layoutY="240.0" onAction="#handleSendAnnouncement" text="Send Update" />
        <Button fx:id="Backbutton" layoutX="250.0" layoutY="240.0" onAction="#handleback" text="Back" />
    </children>
</AnchorPane>
