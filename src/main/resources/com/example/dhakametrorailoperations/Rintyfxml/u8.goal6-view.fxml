<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal6Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Generate Daily Financial Summary Report">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="75.0" text="Select Date:" />
        <DatePicker fx:id="reportDatePicker" layoutX="180.0" layoutY="71.0" prefWidth="200.0" promptText="Choose Date" />

        <Label layoutX="30.0" layoutY="120.0" text="Select Station:" />
        <ComboBox fx:id="stationCombo" layoutX="180.0" layoutY="116.0" prefWidth="200.0" promptText="Choose Station" />

        <Label layoutX="30.0" layoutY="165.0" text="Total Ticket Sales:" />
        <TextField fx:id="ticketSalesField" editable="false" layoutX="180.0" layoutY="161.0" prefWidth="200.0" />

        <Label layoutX="30.0" layoutY="210.0" text="Card Recharge Revenue:" />
        <TextField fx:id="cardRechargeField" editable="false" layoutX="180.0" layoutY="206.0" prefWidth="200.0" />

        <Label layoutX="30.0" layoutY="255.0" text="Total Daily Revenue:" />
        <TextField fx:id="totalRevenueField" editable="false" layoutX="180.0" layoutY="251.0" prefWidth="200.0" />

        <Button fx:id="generateBtn" layoutX="30.0" layoutY="310.0" onAction="#handleGenerateReport" text="Generate Report" />
        <Button fx:id="saveBtn" layoutX="155.0" layoutY="310.0" onAction="#handleSaveReport" text="Save Report" />
        <Button fx:id="Backbutton" layoutX="255.0" layoutY="310.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="365.0" text="Select date and station to generate report." />
    </children>
</AnchorPane>
