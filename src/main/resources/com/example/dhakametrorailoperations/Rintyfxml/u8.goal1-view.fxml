<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.U8goal1Controller">
    <children>
        <Label layoutX="25.0" layoutY="20.0" text="Match Shift-End Cash">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="25.0" layoutY="65.0" text="Shift ID:" />
        <TextField fx:id="shiftIdField" layoutX="85.0" layoutY="61.0" prefWidth="110.0" promptText="SH-01" />

        <Label layoutX="210.0" layoutY="65.0" text="Cashier:" />
        <TextField fx:id="cashierNameField" layoutX="265.0" layoutY="61.0" prefWidth="140.0" promptText="Cashier Name" />

        <Label layoutX="420.0" layoutY="65.0" text="Station:" />
        <TextField fx:id="stationField" layoutX="475.0" layoutY="61.0" prefWidth="130.0" promptText="Station Name" />

        <Label layoutX="25.0" layoutY="105.0" text="System Total (BDT):" />
        <TextField fx:id="systemTotalInputField" layoutX="145.0" layoutY="101.0" prefWidth="140.0" promptText="Enter System Total" />
        <Button fx:id="addEntryBtn" layoutX="300.0" layoutY="101.0" onAction="#handleAddEntry" text="Add Shift Entry" />

        <TableView fx:id="cashHandoverTable" layoutX="25.0" layoutY="145.0" onMouseClicked="#handleRowSelect" prefHeight="210.0" prefWidth="670.0">
            <columns>
                <TableColumn fx:id="shiftIdCol" prefWidth="95.0" text="Shift ID" />
                <TableColumn fx:id="cashierNameCol" prefWidth="160.0" text="Cashier Name" />
                <TableColumn fx:id="stationCol" prefWidth="145.0" text="Station" />
                <TableColumn fx:id="systemTotalCol" prefWidth="145.0" text="System Total (BDT)" />
                <TableColumn fx:id="statusCol" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>

        <Label layoutX="25.0" layoutY="375.0" text="Selected Cashier:" />
        <Label fx:id="cashierNameLabel" layoutX="130.0" layoutY="375.0" text="None" />

        <Label layoutX="330.0" layoutY="375.0" text="System Total (BDT):" />
        <Label fx:id="systemTotalLabel" layoutX="450.0" layoutY="375.0" text="0.00" />

        <Label layoutX="25.0" layoutY="415.0" text="Counted Cash (BDT):" />
        <TextField fx:id="countedCashField" layoutX="150.0" layoutY="411.0" prefWidth="150.0" promptText="Enter amount" />
        <Button fx:id="checkDiffBtn" layoutX="315.0" layoutY="411.0" onAction="#handleCheckDifference" text="Check Difference" />

        <Label layoutX="445.0" layoutY="415.0" text="Difference (BDT):" />
        <Label fx:id="differenceLabel" layoutX="550.0" layoutY="415.0" text="0.00" />

        <Button fx:id="approveMatchBtn" layoutX="25.0" layoutY="465.0" onAction="#handleApproveMatch" text="Approve Cash Match" />
        <Button fx:id="Backbutton" layoutX="175.0" layoutY="465.0" onAction="#handleback" text="Back" />
    </children>
</AnchorPane>
