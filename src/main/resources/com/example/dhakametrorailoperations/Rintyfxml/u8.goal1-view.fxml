<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal1Controller">
    <children>
        <Label layoutX="25.0" layoutY="20.0" text="Match Shift-End Cash">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="cashHandoverTable" layoutX="25.0" layoutY="60.0" onMouseClicked="#handleRowSelect" prefHeight="220.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="shiftIdCol" prefWidth="100.0" text="Shift ID" />
                <TableColumn fx:id="cashierNameCol" prefWidth="150.0" text="Cashier Name" />
                <TableColumn fx:id="stationCol" prefWidth="130.0" text="Station" />
                <TableColumn fx:id="systemTotalCol" prefWidth="140.0" text="System Total (BDT)" />
                <TableColumn fx:id="statusCol" prefWidth="125.0" text="Status" />
            </columns>
        </TableView>

        <Label layoutX="25.0" layoutY="300.0" text="Cashier Name:" />
        <Label fx:id="cashierNameLabel" layoutX="120.0" layoutY="300.0" text="None" />

        <Label layoutX="320.0" layoutY="300.0" text="System Total (BDT):" />
        <Label fx:id="systemTotalLabel" layoutX="440.0" layoutY="300.0" text="0.00" />

        <Label layoutX="25.0" layoutY="340.0" text="Counted Cash (BDT):" />
        <TextField fx:id="countedCashField" layoutX="150.0" layoutY="336.0" prefWidth="150.0" promptText="Enter amount" />
        <Button fx:id="checkDiffBtn" layoutX="315.0" layoutY="336.0" onAction="#handleCheckDifference" text="Check Difference" />

        <Label layoutX="445.0" layoutY="340.0" text="Difference (BDT):" />
        <Label fx:id="differenceLabel" layoutX="550.0" layoutY="340.0" text="0.00" />

        <Button fx:id="approveMatchBtn" layoutX="25.0" layoutY="390.0" onAction="#handleApproveMatch" text="Approve Cash Match" />
        <Button fx:id="Backbutton" layoutX="175.0" layoutY="390.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="25.0" layoutY="445.0" text="Select a row from the table." />
    </children>
</AnchorPane>
