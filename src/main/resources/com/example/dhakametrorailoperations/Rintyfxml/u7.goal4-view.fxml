<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="430.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal4Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Control Passenger Flow (Crowded Hours)">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Select Station Area:" />
        <ComboBox fx:id="areaCombo" layoutX="170.0" layoutY="76.0" prefWidth="220.0" promptText="Choose Area" />

        <Label layoutX="30.0" layoutY="130.0" text="Select Control Level:" />
        <ComboBox fx:id="levelCombo" layoutX="170.0" layoutY="126.0" prefWidth="220.0" promptText="Choose Level" />

        <Label layoutX="30.0" layoutY="180.0" text="Crowd Status:" />
        <TextField fx:id="crowdStatusField" editable="false" layoutX="170.0" layoutY="176.0" prefWidth="220.0" />

        <Button fx:id="checkBtn" layoutX="30.0" layoutY="240.0" onAction="#handleCheckCrowd" text="Check Crowd" />
        <Button fx:id="applyBtn" layoutX="135.0" layoutY="240.0" onAction="#handleApplyControl" text="Apply Control" />
        <Button fx:id="Backbutton" layoutX="245.0" layoutY="240.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="300.0" text="Select an area and control level." />
    </children>
</AnchorPane>