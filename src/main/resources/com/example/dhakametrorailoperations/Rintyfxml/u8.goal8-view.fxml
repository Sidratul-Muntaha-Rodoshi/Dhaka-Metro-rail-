<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="460.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u8goal8Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Monthly Revenue &amp; Expense Overview">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="75.0" text="Select Month:" />
        <ComboBox fx:id="monthCombo" layoutX="180.0" layoutY="71.0" prefWidth="200.0" promptText="Choose Month" />

        <Label layoutX="30.0" layoutY="120.0" text="Select Station:" />
        <ComboBox fx:id="stationCombo" layoutX="180.0" layoutY="116.0" prefWidth="200.0" promptText="Choose Station" />

        <Label layoutX="30.0" layoutY="165.0" text="Total Revenue (BDT):" />
        <TextField fx:id="totalRevenueField" editable="false" layoutX="180.0" layoutY="161.0" prefWidth="200.0" />

        <Label layoutX="30.0" layoutY="210.0" text="Total Expense (BDT):" />
        <TextField fx:id="totalExpenseField" editable="false" layoutX="180.0" layoutY="206.0" prefWidth="200.0" />

        <Label layoutX="30.0" layoutY="255.0" text="Net Profit / Loss:" />
        <TextField fx:id="netBalanceField" editable="false" layoutX="180.0" layoutY="251.0" prefWidth="200.0" />

        <Button fx:id="viewOverviewBtn" layoutX="30.0" layoutY="310.0" onAction="#handleViewOverview" text="View Overview" />
        <Button fx:id="clearBtn" layoutX="145.0" layoutY="310.0" onAction="#handleClear" text="Clear" />
        <Button fx:id="Backbutton" layoutX="215.0" layoutY="310.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="365.0" text="Select month and station to view overview." />
    </children>
</AnchorPane>
