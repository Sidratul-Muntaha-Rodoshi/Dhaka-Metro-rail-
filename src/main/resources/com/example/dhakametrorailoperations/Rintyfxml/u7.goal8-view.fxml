<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="380.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal8Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Request Money for Station Repairs &amp; Expenses">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Expense Category:" />
        <ComboBox fx:id="shiftCombo" layoutX="170.0" layoutY="76.0" prefWidth="230.0" promptText="Select Expense Category" />

        <Label layoutX="30.0" layoutY="130.0" text="Urgency Level::" />
        <ComboBox fx:id="conditionCombo" layoutX="170.0" layoutY="126.0" prefWidth="230.0" promptText="Select Urgency Level" />

        <Label layoutX="30.0" layoutY="180.0" text="Estimated Cost (BDT):" />
        <TextField fx:id="noteField" layoutX="170.0" layoutY="176.0" prefWidth="230.0" promptText="Enter Estimated Cost (BDT)" />

        <Button fx:id="checkBtn" layoutX="30.0" layoutY="240.0" onAction="#handleCheckShift" text="Check Budget" />
        <Button fx:id="saveBtn" layoutX="130.0" layoutY="240.0" onAction="#handleSaveLog" text="Submit Request" />
        <Button fx:id="Backbutton" layoutX="260.0" layoutY="240.0" onAction="#handleback" text="Back" />
    </children>
</AnchorPane>
