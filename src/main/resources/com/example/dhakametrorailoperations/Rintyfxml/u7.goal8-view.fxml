<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal8Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Daily Station Shift Log &amp; Handover">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Select Shift:" />
        <ComboBox fx:id="shiftCombo" layoutX="170.0" layoutY="76.0" prefWidth="230.0" promptText="Choose Shift" />

        <Label layoutX="30.0" layoutY="130.0" text="Station Condition:" />
        <ComboBox fx:id="conditionCombo" layoutX="170.0" layoutY="126.0" prefWidth="230.0" promptText="Choose Condition" />

        <Label layoutX="30.0" layoutY="180.0" text="Handover Note:" />
        <TextField fx:id="noteField" layoutX="170.0" layoutY="176.0" prefWidth="230.0" promptText="Write shift summary" />

        <Button fx:id="checkBtn" layoutX="30.0" layoutY="240.0" onAction="#handleCheckShift" text="Check Shift" />
        <Button fx:id="saveBtn" layoutX="130.0" layoutY="240.0" onAction="#handleSaveLog" text="Save &amp; Handover" />
        <Button fx:id="Backbutton" layoutX="260.0" layoutY="240.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="300.0" text="Select shift and station condition." />
    </children>
</AnchorPane>