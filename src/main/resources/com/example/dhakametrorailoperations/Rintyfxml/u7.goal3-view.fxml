<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rinty.u7goal3Controller">
    <children>
        <Label layoutX="30.0" layoutY="25.0" text="Set Entry and Exit Modes for Ticket Gates">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="80.0" text="Select Gate:" />
        <ComboBox fx:id="gateCombo" layoutX="160.0" layoutY="76.0" prefWidth="220.0" promptText="Choose Gate" />

        <Label layoutX="30.0" layoutY="130.0" text="Select Mode:" />
        <ComboBox fx:id="modeCombo" layoutX="160.0" layoutY="126.0" prefWidth="220.0" promptText="Choose Mode" />

        <Label layoutX="30.0" layoutY="180.0" text="Current Status:" />
        <TextField fx:id="gateStatusField" editable="false" layoutX="160.0" layoutY="176.0" prefWidth="220.0" />

        <Button fx:id="checkBtn" layoutX="30.0" layoutY="240.0" onAction="#handleCheckGate" text="Check Gate" />
        <Button fx:id="applyBtn" layoutX="130.0" layoutY="240.0" onAction="#handleApplyMode" text="Set Mode" />
        <Button fx:id="Backbutton" layoutX="220.0" layoutY="240.0" onAction="#handleback" text="Back" />

        <Label fx:id="statusLabel" layoutX="30.0" layoutY="300.0" text="Select a gate and mode." />
    </children>
</AnchorPane>