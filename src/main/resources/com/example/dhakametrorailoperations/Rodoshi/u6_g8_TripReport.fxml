<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rodoshi.u6_g8_TripReportController">
    <children>
        <ComboBox fx:id="tripIdComboBox" layoutX="235.0" layoutY="60.0" prefWidth="180.0" promptText="Trip ID" />

        <Label fx:id="totalDelayLabel" layoutX="80.0" layoutY="125.0" prefWidth="150.0" text="Total Delay " />
        <Label fx:id="lateStationsLabel" layoutX="255.0" layoutY="125.0" prefWidth="150.0" text="Late Stations " />
        <Label fx:id="onTimeRateLabel" layoutX="430.0" layoutY="125.0" prefWidth="150.0" text="On Time Rate " />

        <Label fx:id="technicalFaultsLabel" layoutX="80.0" layoutY="185.0" prefWidth="150.0" text="Technical Faults " />
        <Label fx:id="emergencyCountLabel" layoutX="255.0" layoutY="185.0" prefWidth="150.0" text="Emergency Count " />
        <Label fx:id="tripStatusLabel" layoutX="430.0" layoutY="185.0" prefWidth="150.0" text="Trip Status " />

        <Button layoutX="170.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleCalculateSummary" prefWidth="140.0" text="Calculate Summary" />
        <Button layoutX="325.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleCompleteTrip" prefWidth="120.0" text="Complete Trip" />
        <Button layoutX="460.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleBack" prefWidth="90.0" text="Back" />
    </children>
</AnchorPane>
