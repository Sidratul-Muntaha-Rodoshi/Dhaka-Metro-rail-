            <Button layoutX="524.0" layoutY="19.0" mnemonicParsing="false" onAction="#handleLogOut" text="Log Out" />
         </children>
      </AnchorPane>
      <Button layoutX="96.0" layoutY="87.0" mnemonicParsing="false" onAction="#handleSafetyCheck" prefHeight="71.0" prefWidth="129.0" style="-fx-font-weight: bold;" text="Safety Check" />
      <Button layoutX="96.0" layoutY="165.0" mnemonicParsing="false" onAction="#handleStartTrip" prefHeight="63.0" prefWidth="129.0" style="-fx-font-weight: bold;" text="Start Trip" />
