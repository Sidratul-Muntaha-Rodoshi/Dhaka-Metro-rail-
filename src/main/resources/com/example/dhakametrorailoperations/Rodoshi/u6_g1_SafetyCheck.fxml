<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rodoshi.u6_g1_SafetyCheckController">
    <children>
        <Text layoutX="75.0" layoutY="58.0" text="Train ID" />
        <ComboBox fx:id="trainIDComboBox" layoutX="215.0" layoutY="40.0" prefWidth="150.0" />

        <Text layoutX="75.0" layoutY="93.0" text="Brake" />
        <ComboBox fx:id="brakeResultComboBox" layoutX="215.0" layoutY="75.0" prefWidth="150.0" />

        <Text layoutX="75.0" layoutY="128.0" text="Door" />
        <ComboBox fx:id="doorResultComboBox" layoutX="215.0" layoutY="110.0" prefWidth="150.0" />

        <Text layoutX="75.0" layoutY="163.0" text="Headlight" />
        <ComboBox fx:id="headlightResultComboBox" layoutX="215.0" layoutY="145.0" prefWidth="150.0" />

        <Text layoutX="75.0" layoutY="198.0" text="Communication" />
        <ComboBox fx:id="communicationResultComboBox" layoutX="215.0" layoutY="180.0" prefWidth="150.0" />

        <Text layoutX="75.0" layoutY="233.0" text="Emergency Equipment" />
        <ComboBox fx:id="emergencyEquipmentResultComboBox" layoutX="215.0" layoutY="215.0" prefWidth="150.0" />

        <Text layoutX="75.0" layoutY="268.0" text="Station Controller ID" />
        <TextField fx:id="stationControllerIDTextField" layoutX="215.0" layoutY="250.0" prefWidth="150.0" />

        <Label fx:id="trainStatusLabel" layoutX="215.0" layoutY="288.0" prefWidth="250.0" text="" />

        <Button layoutX="215.0" layoutY="320.0" mnemonicParsing="false" onAction="#handleSubmitCheck" prefWidth="120.0" text="Submit Check" />
        <Button layoutX="350.0" layoutY="320.0" mnemonicParsing="false" onAction="#handleBack" prefWidth="75.0" text="Back" />
    </children>
</AnchorPane>
