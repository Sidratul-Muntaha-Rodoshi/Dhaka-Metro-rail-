<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rodoshi.u6_g6_PSDProblemController">
    <children>
        <ComboBox fx:id="stationComboBox" layoutX="235.0" layoutY="55.0" prefWidth="180.0" promptText="Station" />

        <ComboBox fx:id="platformComboBox" layoutX="235.0" layoutY="100.0" prefWidth="180.0" promptText="Platform" />

        <ComboBox fx:id="problemTypeComboBox" layoutX="235.0" layoutY="145.0" prefWidth="180.0" promptText="Problem Type" />

        <Text layoutX="125.0" layoutY="208.0" text="Problem Details" />
        <TextField fx:id="problemDetailsTextField" layoutX="235.0" layoutY="190.0" prefWidth="230.0" />

        <Label fx:id="reportNumberLabel" layoutX="235.0" layoutY="240.0" prefWidth="180.0" text="Report Number " />

        <Button layoutX="215.0" layoutY="285.0" mnemonicParsing="false" onAction="#handleSendReport" prefWidth="125.0" text="Send Report" />
        <Button layoutX="360.0" layoutY="285.0" mnemonicParsing="false" onAction="#handleBack" prefWidth="95.0" text="Back" />
    </children>
</AnchorPane>
