<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rodoshi.u6_g2_StartTripController">
    <children>
        <Text layoutX="80.0" layoutY="78.0" text="Train ID" />
        <ComboBox fx:id="trainIdComboBox" layoutX="175.0" layoutY="60.0" prefWidth="140.0" promptText="Select Train" />

        <Text layoutX="80.0" layoutY="118.0" text="Trip ID" />
        <ComboBox fx:id="tripIdComboBox" layoutX="175.0" layoutY="100.0" prefWidth="140.0" promptText="Select Trip" />

        <Text layoutX="80.0" layoutY="158.0" text="Clearance ID" />
        <TextField fx:id="clearanceIdTextField" layoutX="175.0" layoutY="140.0" prefWidth="140.0" />

        <Label fx:id="routeLabel" layoutX="355.0" layoutY="64.0" prefWidth="180.0" text="Route" />
        <Label fx:id="departureTimeLabel" layoutX="355.0" layoutY="104.0" prefWidth="180.0" text="Departure Time" />

        <Text layoutX="80.0" layoutY="198.0" text="Reason" />
        <TextField fx:id="reasonTextField" layoutX="175.0" layoutY="180.0" prefWidth="140.0" />

        <Label fx:id="tripStatusLabel" layoutX="175.0" layoutY="225.0" prefWidth="310.0" text="Trip Status" />

        <Button layoutX="175.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleStartTrip" prefWidth="115.0" text="Start Trip" />
        <Button layoutX="345.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleBack" prefWidth="75.0" text="Back" />
    </children>
</AnchorPane>
