<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.dhakametrorailoperations.Rodoshi.u6_g3_StationTimingController">
    <children>
        <Text layoutX="80.0" layoutY="63.0" text="Station" />
        <ComboBox fx:id="stationComboBox" layoutX="185.0" layoutY="45.0" prefWidth="150.0" promptText="station" />

        <Label fx:id="scheduledArrivalLabel" layoutX="80.0" layoutY="104.0" prefWidth="165.0" text="scheduledArrivalLabel" />
        <Label fx:id="actualArrivalLabel" layoutX="260.0" layoutY="104.0" prefWidth="155.0" text="actualArrivalLabel" />
        <Label fx:id="arrivalDelayLabel" layoutX="430.0" layoutY="104.0" prefWidth="145.0" text="arrivalDelayLabel" />

        <Button layoutX="185.0" layoutY="135.0" mnemonicParsing="false" onAction="#handleRecordArrival" prefWidth="130.0" text="Record Arrival" />

        <Text layoutX="80.0" layoutY="193.0" text="Delay Reason" />
        <ComboBox fx:id="delayReasonComboBox" layoutX="185.0" layoutY="175.0" prefWidth="150.0" promptText="delayReason" />

        <Label fx:id="actualDepartureLabel" layoutX="80.0" layoutY="229.0" prefWidth="165.0" text="actualDepartureLabel" />
        <Label fx:id="departureDelayLabel" layoutX="260.0" layoutY="229.0" prefWidth="155.0" text="departureDelayLabel" />
        <Label fx:id="totalDelayLabel" layoutX="430.0" layoutY="229.0" prefWidth="145.0" text="totalDelayLabel" />

        <Button layoutX="185.0" layoutY="270.0" mnemonicParsing="false" onAction="#handleRecordDeparture" prefWidth="135.0" text="Record Departure" />
        <Button layoutX="340.0" layoutY="270.0" mnemonicParsing="false" onAction="#handleBack" prefWidth="75.0" text="Back" />
    </children>
</AnchorPane>
